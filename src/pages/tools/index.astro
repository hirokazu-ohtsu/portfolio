---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOOLS } from '../../tools';
---

<BaseLayout title="無料ツール" description="Webマーケティング・計測の実務で使える無料ツールの一覧です。">
  <main class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold tracking-tight">無料ツール</h1>
    <p class="mt-3 text-slate-600">実務で使う作業を、ブラウザだけで完結できるようにしたツールです。</p>
    <ul class="mt-8 space-y-4">
      {TOOLS.map((t) => (
        <li>
          <a href={t.href} class="block rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 transition hover:ring-indigo-300">
            <p class="font-semibold">{t.name}</p>
            <p class="mt-1 text-sm leading-relaxed text-slate-600">{t.summary}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
