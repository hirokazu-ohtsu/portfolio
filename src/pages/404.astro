---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ページが見つかりません">
  <main class="mx-auto max-w-3xl px-4 py-20 text-center">
    <p class="text-sm font-semibold text-indigo-600">404</p>
    <h1 class="mt-2 text-2xl font-bold">ページが見つかりません</h1>
    <p class="mt-3 text-slate-600">URLが変わったか、ページが削除された可能性があります。</p>
    <a href="/" class="mt-8 inline-block rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">ホームへ戻る</a>
  </main>
</BaseLayout>
