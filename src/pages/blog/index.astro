---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="記事" description="Webマーケティングとデータ計測の実務ノウハウ記事の一覧です。">
  <main class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold tracking-tight">記事</h1>
    <ul class="mt-8 space-y-4">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="block rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 transition hover:ring-indigo-300">
            <time class="text-xs text-slate-500" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <p class="mt-1 font-semibold leading-snug">{post.data.title}</p>
            <p class="mt-1 text-sm leading-relaxed text-slate-600">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
