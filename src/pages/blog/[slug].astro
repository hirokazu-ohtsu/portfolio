---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <article>
      <header>
        <time class="text-sm text-slate-500" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <h1 class="mt-2 text-2xl font-bold leading-snug tracking-tight sm:text-3xl">{post.data.title}</h1>
      </header>
      <div class="prose prose-slate mt-8 max-w-none prose-headings:tracking-tight prose-a:text-indigo-600 prose-code:before:content-none prose-code:after:content-none prose-table:text-sm">
        <Content />
      </div>
    </article>
    <p class="mt-12"><a href="/blog/" class="text-sm text-indigo-600 underline">← 記事一覧へ</a></p>
  </main>
</BaseLayout>
